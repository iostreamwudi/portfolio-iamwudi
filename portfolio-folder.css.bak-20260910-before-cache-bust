/* Selected work folder interaction — scoped so the existing portfolio stays intact. */
.project-folder-section {
  position: relative;
  overflow: hidden;
}

.project-folder-section::before {
  position: absolute;
  inset: 18% 8% auto;
  height: 26rem;
  border-radius: 50%;
  background: radial-gradient(circle, rgba(135, 177, 63, 0.16), transparent 68%);
  content: "";
  pointer-events: none;
  filter: blur(10px);
}

.project-folder-heading {
  position: relative;
  z-index: 1;
}

.project-folder-heading p {
  max-width: 34rem;
}

.project-folder-scene {
  position: relative;
  isolation: isolate;
  min-height: 35rem;
  margin: 3rem auto 0;
  max-width: 74rem;
  perspective: 1400px;
}

.folder-project {
  position: absolute;
  top: 4.6rem;
  left: 50%;
  display: flex;
  width: min(22rem, 38vw);
  min-height: 27rem;
  flex-direction: column;
  overflow: hidden;
  border: 1px solid rgba(29, 45, 32, 0.14);
  border-radius: 1.35rem;
  background: rgba(255, 255, 255, 0.82);
  box-shadow: 0 1.2rem 3rem rgba(48, 65, 42, 0.16), inset 0 1px 0 rgba(255, 255, 255, 0.78);
  color: #172018;
  text-decoration: none;
  transform-origin: 50% 100%;
  transition: transform 520ms cubic-bezier(0.22, 1, 0.36, 1), box-shadow 350ms ease, filter 350ms ease;
  will-change: transform;
}

.folder-project::after {
  position: absolute;
  inset: 0;
  background: linear-gradient(120deg, rgba(255, 255, 255, 0.32), transparent 34%, transparent 72%, rgba(123, 157, 68, 0.1));
  content: "";
  pointer-events: none;
}

.folder-project-servicepilot {
  z-index: 1;
  transform: translateX(calc(-50% - 7.4rem)) rotate(-7deg) translateY(1.8rem);
}

.folder-project-forge {
  z-index: 2;
  transform: translateX(calc(-50% + 7.4rem)) rotate(7deg) translateY(1.15rem);
}

.folder-project:hover,
.folder-project:focus-visible {
  box-shadow: 0 1.7rem 3.5rem rgba(48, 65, 42, 0.24), inset 0 1px 0 rgba(255, 255, 255, 0.78);
  filter: saturate(1.04);
}

.folder-project:focus-visible,
.folder-cover:focus-visible {
  outline: 3px solid rgba(103, 154, 42, 0.75);
  outline-offset: 5px;
}

.folder-project-forge:hover,
.folder-project-forge:focus-visible,
.project-folder-scene:hover .folder-project-forge,
.project-folder-scene:focus-within .folder-project-forge,
.project-folder-scene.is-open .folder-project-forge {
  z-index: 5;
  transform: translateX(calc(-50% + 8.6rem)) rotate(3deg) translateY(-5.8rem) scale(1.03);
}

.project-folder-scene:hover .folder-project-servicepilot,
.project-folder-scene:focus-within .folder-project-servicepilot,
.project-folder-scene.is-open .folder-project-servicepilot {
  transform: translateX(calc(-50% - 9.2rem)) rotate(-10deg) translateY(-3.7rem) scale(0.98);
}

.folder-project-cover {
  position: relative;
  display: grid;
  height: 14rem;
  place-items: center;
  overflow: hidden;
  background: #e6edd8;
}

.folder-project-cover::before {
  position: absolute;
  inset: 1.8rem 1.6rem auto;
  height: 8rem;
  border-radius: 50%;
  background: rgba(113, 161, 52, 0.28);
  content: "";
  filter: blur(10px);
}

.folder-project-cover--forge {
  background: #1c2118;
}

.folder-project-cover--forge::before {
  background: rgba(186, 255, 38, 0.34);
}

.folder-project-cover--forge img {
  position: relative;
  z-index: 1;
  display: block;
  box-sizing: border-box;
  width: 100%;
  height: 100%;
  padding: 0.55rem;
  object-fit: contain !important;
}

.folder-project-cover span {
  position: relative;
  z-index: 1;
  color: #20301f;
  font-size: clamp(2.3rem, 5vw, 3.5rem);
  font-weight: 700;
  letter-spacing: -0.08em;
}

.folder-project-cover--forge span {
  color: #c6ff31;
  letter-spacing: -0.04em;
}

.folder-project-copy {
  display: flex;
  flex: 1;
  flex-direction: column;
  padding: 1.2rem 1.3rem 1.35rem;
}

.folder-project-kicker {
  margin: 0 0 0.65rem;
  color: #6a8740;
  font-size: 0.65rem;
  font-weight: 700;
  letter-spacing: 0.15em;
  text-transform: uppercase;
}

.folder-project-forge .folder-project-kicker {
  color: #779c2c;
}

.folder-project-copy h3 {
  margin: 0;
  font-size: clamp(1.7rem, 3.6vw, 2.35rem);
  letter-spacing: -0.07em;
}

.folder-project-copy p:not(.folder-project-kicker) {
  margin: 0.55rem 0 0;
  color: #667067;
  font-size: 0.9rem;
  line-height: 1.65;
}

.folder-project-forge .folder-project-copy p:not(.folder-project-kicker) {
  color: #68715f;
}

.folder-project-arrow {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: auto;
  padding-top: 1.1rem;
  color: #4d7124;
  font-size: 0.82rem;
  font-weight: 700;
}

.folder-project-arrow span:last-child {
  display: grid;
  width: 2.1rem;
  height: 2.1rem;
  place-items: center;
  border: 1px solid currentColor;
  border-radius: 50%;
  font-size: 1.15rem;
  transition: transform 250ms ease;
}

.folder-project:hover .folder-project-arrow span:last-child,
.folder-project:focus-visible .folder-project-arrow span:last-child {
  transform: translateX(0.2rem);
}

.folder-cover {
  position: absolute;
  z-index: 4;
  bottom: 0.6rem;
  left: 50%;
  display: flex;
  width: min(31rem, 76vw);
  min-height: 10rem;
  flex-direction: column;
  justify-content: flex-end;
  padding: 2.5rem 2rem 1.5rem;
  border: 1px solid rgba(72, 103, 36, 0.32);
  border-radius: 1.4rem 1.4rem 1.1rem 1.1rem;
  background: linear-gradient(145deg, #8eaf53, #70983c);
  box-shadow: 0 1.5rem 3rem rgba(72, 103, 36, 0.22), inset 0 1px 0 rgba(255, 255, 255, 0.25);
  color: #f8fbef;
  cursor: pointer;
  text-align: left;
  transform: translateX(-50%);
  transition: transform 350ms ease, box-shadow 350ms ease;
}

.folder-cover::before {
  position: absolute;
  top: -1.1rem;
  left: 1.5rem;
  width: 8.4rem;
  height: 2rem;
  border-radius: 0.9rem 0.9rem 0 0;
  background: #83a747;
  content: "";
}

.folder-cover::after {
  position: absolute;
  inset: 0;
  border-radius: inherit;
  background: linear-gradient(120deg, rgba(255, 255, 255, 0.18), transparent 35%);
  content: "";
  pointer-events: none;
}

.folder-cover:hover,
.project-folder-scene:focus-within .folder-cover,
.project-folder-scene.is-open .folder-cover {
  box-shadow: 0 1.8rem 3.5rem rgba(72, 103, 36, 0.3), inset 0 1px 0 rgba(255, 255, 255, 0.3);
  transform: translateX(-50%) translateY(0.35rem);
}

.folder-cover-label,
.folder-cover-hint {
  position: relative;
  z-index: 1;
}

.folder-cover-label {
  font-size: clamp(1.4rem, 3.2vw, 2.2rem);
  font-weight: 700;
  letter-spacing: -0.06em;
}

.folder-cover-hint {
  display: flex;
  align-items: center;
  gap: 0.55rem;
  margin-top: 0.35rem;
  color: rgba(248, 251, 239, 0.78);
  font-size: 0.78rem;
}

.folder-cover-hint::after {
  content: "↗";
  font-size: 1.05rem;
  transition: transform 250ms ease;
}

.folder-cover:hover .folder-cover-hint::after,
.project-folder-scene.is-open .folder-cover-hint::after {
  transform: translate(0.15rem, -0.15rem);
}

.project-folder-note {
  position: relative;
  z-index: 1;
  margin: 1.25rem auto 0;
  color: #718071;
  font-size: 0.82rem;
  text-align: center;
}

/* The FORGE artwork is taller than the generic card cover. Keep its full
   wordmark visible at every viewport width. */
.folder-project-cover--forge {
  height: auto;
  min-height: 0;
  aspect-ratio: 915 / 740;
}

@media (max-width: 720px) {
  .project-folder-scene {
    min-height: 29rem;
    margin-top: 2.2rem;
  }

  .folder-project {
    top: 3.4rem;
    width: min(14.5rem, 48vw);
    min-height: 22rem;
    border-radius: 1rem;
  }

  .folder-project-servicepilot {
    transform: translateX(calc(-50% - 4.2rem)) rotate(-7deg) translateY(1.25rem);
  }

  .folder-project-forge {
    transform: translateX(calc(-50% + 4.2rem)) rotate(7deg) translateY(0.8rem);
  }

  .project-folder-scene:hover .folder-project-servicepilot,
  .project-folder-scene:focus-within .folder-project-servicepilot,
  .project-folder-scene.is-open .folder-project-servicepilot {
    transform: translateX(calc(-50% - 5.25rem)) rotate(-10deg) translateY(-2.7rem) scale(0.98);
  }

  .project-folder-scene:hover .folder-project-forge,
  .project-folder-scene:focus-within .folder-project-forge,
  .project-folder-scene.is-open .folder-project-forge {
    transform: translateX(calc(-50% + 5.25rem)) rotate(3deg) translateY(-4.8rem) scale(1.02);
  }

  .folder-project-cover {
    height: 9rem;
  }

  .folder-project-copy {
    padding: 0.9rem;
  }

  .folder-project-copy h3 {
    font-size: 1.35rem;
  }

  .folder-project-copy p:not(.folder-project-kicker) {
    font-size: 0.72rem;
    line-height: 1.5;
  }

  .folder-project-arrow {
    padding-top: 0.75rem;
    font-size: 0.7rem;
  }

  .folder-cover {
    width: min(20rem, 82vw);
    min-height: 8.5rem;
    padding: 1.9rem 1.25rem 1.15rem;
  }
}

@media (prefers-reduced-motion: reduce) {
  .folder-project,
  .folder-cover,
  .folder-project-arrow span:last-child {
    transition-duration: 0.01ms;
  }
}
